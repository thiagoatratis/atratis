# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Só a chave pública (anon / publishable) vai aqui.
# NUNCA coloque a chave service_role / secret em arquivo do front-end.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
